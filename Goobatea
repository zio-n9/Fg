-- Chat Functions
local function SendTeamChat(msg)
    if not msg or msg == "" then return end
    pcall(function()
        if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
            local ch = TextChatService.TextChannels:FindFirstChild("RBXTeam")
            if ch then ch:SendAsync(msg) else TextChatService.TextChannels.RBXGeneral:SendAsync("/team " .. msg) end
        else ReplicatedStorage.DefaultChatSystemChatEvents.SayMessageRequest:FireServer(msg, "Team") end
    end)
end

local function SendWhisper(targetName, msg)
    if not msg or msg == "" or not targetName or targetName == "" then return end
    pcall(function()
        if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
            TextChatService.TextChannels.RBXGeneral:SendAsync("/w " .. targetName .. " " .. msg)
        else ReplicatedStorage.DefaultChatSystemChatEvents.SayMessageRequest:FireServer("/w " .. targetName .. " " .. msg, "All") end
    end)
end

