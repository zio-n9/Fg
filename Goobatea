-- Main Loop
local frameCount, fps, lastTick = 0, 0, tick()

RunService.RenderStepped:Connect(function()
    frameCount = frameCount + 1
    if tick() - lastTick >= 1 then fps, frameCount, lastTick = frameCount, 0, tick() end

    if cfg.CustomFOV and Workspace.CurrentCamera then 
        Workspace.CurrentCamera.FieldOfView = cfg.FOV 
    end

    if cfg.ShowStats then StatsLabel.Text = string.format("⚡ FPS: %d | 📶 Ping: %d ms", fps, math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue())) end

    pcall(function()
        if cfg.FullBright then Lighting.Brightness, Lighting.ClockTime, Lighting.GlobalShadows = 2, 14, false end
        local myChar = LP.Character
        local myHrp, myHum, tar = myChar and myChar:FindFirstChild("HumanoidRootPart"), myChar and myChar:FindFirstChildOfClass("Humanoid"), GetTar()

        if tar and tar:FindFirstChild("HumanoidRootPart") and cfg.Follow and myHum then myHum:MoveTo(tar.HumanoidRootPart.Position) end

        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LP and p.Character then
                local eHrp, eHead, eHum = p.Character:FindFirstChild("HumanoidRootPart"), p.Character:FindFirstChild("Head"), p.Character:FindFirstChildOfClass("Humanoid")
                local isTeam, isFriend, valid = IsSameTeam(p), LP:IsFriendsWith(p.UserId), eHum and eHum.Health > 0
                local pCustom = CustomTarget[p] or {Hitbox = true, Esp = true, Alias = ""}

                if eHrp then
                    if not valid or (cfg.HitTeam and isTeam) or (cfg.HitFriend and isFriend) or not cfg.Hitbox or not pCustom.Hitbox then
                        eHrp.Size, eHrp.Transparency = Vector3.new(2, 2, 1), 1
                    else
                        local tSize = (eHum and (eHum.Sit or eHum:GetState() == Enum.HumanoidStateType.Seated)) and (cfg.Size * 0.3) or cfg.Size
                        eHrp.Size, eHrp.Transparency, eHrp.Color, eHrp.Material, eHrp.CanCollide = Vector3.new(tSize, tSize, tSize), 0.6, Colors[cfg.ColorIdx], Enum.Material.ForceField, false
                    end
                end

                local hl, bg = p.Character:FindFirstChild("GBHL"), eHead and eHead:FindFirstChild("GBESP")
                local txt = bg and bg:FindFirstChild("Txt")
                local showEsp = valid and pCustom.Esp and not ((cfg.EspTeam and isTeam) or (cfg.EspFriend and isFriend))
                local teamColor = p.TeamColor and p.TeamColor.Color or Color3.fromRGB(255, 255, 255)

                if hl then hl.Enabled, hl.FillColor, hl.OutlineColor, hl.FillTransparency = cfg.EspBox and showEsp, Color3.fromRGB(255, 255, 255), Color3.fromRGB(255, 255, 255), AlphaValues[cfg.EspBoxAlphaIdx] end

                if bg and txt then
                    if showEsp and (cfg.EspName or cfg.EspDist or cfg.EspHP) then
                        bg.Enabled = true
                        local hexColor = string.format("#%02X%02X%02X", math.floor(teamColor.R * 255), math.floor(teamColor.G * 255), math.floor(teamColor.B * 255))
                        local t = {}
                        if cfg.EspName then table.insert(t, string.format('<font color="%s">%s</font>', hexColor, (pCustom.Alias and pCustom.Alias ~= "") and (p.DisplayName .. " [" .. pCustom.Alias .. "]") or p.DisplayName)) end
                        if cfg.EspHP then table.insert(t, string.format('<font color="#FFFFFF">❤️ %d/%d</font>', math.floor(eHum.Health), math.floor(eHum.MaxHealth))) end
                        if cfg.EspDist and myHrp and eHrp then table.insert(t, string.format('<font color="#FFFFFF">📏 %dm</font>', math.floor((myHrp.Position - eHrp.Position).Magnitude))) end
                        txt.Text = table.concat(t, "\n")
                    else bg.Enabled = false end
                end
            end
        end
    end)
end)
