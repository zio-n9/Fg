-- AimBot Calculation Function
local function GetClosestPlayerForAim()
    local closest, maxDist = nil, cfg.AimFOV
    local mousePos = UserInputService:GetMouseLocation()

    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LP and p.Character then
            local eHum = p.Character:FindFirstChildOfClass("Humanoid")
            local targetPart = p.Character:FindFirstChild(AimParts[cfg.AimPartIdx])
            local isTeam, isFriend = IsSameTeam(p), LP:IsFriendsWith(p.UserId)
            local pCustom = CustomTarget[p] or {Aimbot = true, Hitbox = true, Esp = true}

            if eHum and eHum.Health > 0 and targetPart then
                local isAimAllowed = (pCustom.Aimbot ~= false)
                if isAimAllowed and not (cfg.AimTeam and isTeam) and not (cfg.AimFriend and isFriend) then
                    local screenPos, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
                    if onScreen then
                        local dist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
                        if dist < maxDist then
                            maxDist = dist
                            closest = targetPart
                        end
                    end
                end
            end
        end
    end
    return closest
end

