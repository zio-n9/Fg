local function GetClosestPlayerForAim()
    local closest, maxDist = nil, cfg.AimFOV
    local mousePos = UserInputService:GetMouseLocation()

    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LP and p.Character then
            local eHum = p.Character:FindFirstChildOfClass("Humanoid")
            local targetPart = p.Character:FindFirstChild(AimParts[cfg.AimPartIdx])
            local isTeam, isFriend = IsSameTeam(p), LP:IsFriendsWith(p.UserId)
            local pCustom = CustomTarget[p] or {Aimbot = true, Hitbox = true, Esp = true}

            if eHum and eHum.Health > 0 and targetPart then
                if pCustom.Aimbot ~= false and not (cfg.AimTeam and isTeam) and not (cfg.AimFriend and isFriend) then
                    local screenPos, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
                    if onScreen then
                        local dist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
                        if dist < maxDist then
                            maxDist = dist
                            closest = targetPart
                        end
                    end
                end
            end
        end
    end
    return closest
end

local function SetupESP(p)
    if p == LP then return end
    local function Add(c)
        if not c then return end
        local head = c:WaitForChild("Head", 5) if not head then return end
        if not c:FindFirstChild("GBHL") then
            local hl = Instance.new("Highlight", c) hl.Name, hl.Enabled = "GBHL", false
        end
        if not head:FindFirstChild("GBESP") then
            local bg = Instance.new("BillboardGui", head) bg.Name, bg.Size, bg.StudsOffset, bg.AlwaysOnTop, bg.Enabled = "GBESP", UDim2.new(0, 200, 0, 50), Vector3.new(0, 2.5, 0), true, false
            local txt = Instance.new("TextLabel", bg) txt.Name, txt.Size, txt.BackgroundTransparency, txt.Font, txt.TextSize, txt.TextStrokeTransparency, txt.RichText, txt.TextColor3 = "Txt", UDim2.new(1, 0, 1, 0), 1, Enum.Font.GothamBold, 13, 0.2, true, Color3.fromRGB(255, 255, 255)
        end
    end
    if p.Character then Add(p.Character) end
    p.CharacterAdded:Connect(Add)
end

