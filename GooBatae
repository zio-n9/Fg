-- 💾 ฟังก์ชั่นบันทึกรูปภาพลงเครื่องอัตโนมัติ
local function SaveBgData(bgType, value, trans)
    if writefile and HttpService then
        pcall(function()
            local data = HttpService:JSONEncode({
                Type = bgType,
                Value = value,
                Transparency = trans or BgImage.ImageTransparency
            })
            writefile(BG_CONFIG_FILE, data)
        end)
    end
end

-- 📂 ฟังก์ชั่นโหลดรูปภาพจากเครื่องเมื่อเข้าเกมใหม่
local function LoadSavedBg()
    if isfile and readfile and isfile(BG_CONFIG_FILE) and HttpService then
        pcall(function()
            local raw = readfile(BG_CONFIG_FILE)
            local data = HttpService:JSONDecode(raw)
            if data then
                if data.Transparency then BgImage.ImageTransparency = data.Transparency end
                if data.Type == "AssetID" then
                    BgImage.Image = "rbxassetid://" .. data.Value
                elseif data.Type == "URL" then
                    if isfile(BG_IMAGE_FILE) and getcustomasset then
                        BgImage.Image = getcustomasset(BG_IMAGE_FILE)
                    end
                end
            end
        end)
    end
end

