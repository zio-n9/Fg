-- Chat Switchers
local function SwitchToTeamChat()
    pcall(function()
        if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
            local teamChannel = TextChatService.TextChannels:FindFirstChild("RBXTeam")
            if teamChannel then TextChatService.TargetTextChannel = teamChannel end
            local general = TextChatService.TextChannels:FindFirstChild("RBXGeneral")
            if general then general:SendAsync("/team") end
        else 
            ReplicatedStorage.DefaultChatSystemChatEvents.SayMessageRequest:FireServer("/team", "All")
        end
    end)
end

local function SwitchToWhisper(targetName)
    if not targetName or targetName == "" then return end
    pcall(function()
        if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
            local general = TextChatService.TextChannels:FindFirstChild("RBXGeneral")
            if general then general:SendAsync("/w " .. targetName) end
        else 
            ReplicatedStorage.DefaultChatSystemChatEvents.SayMessageRequest:FireServer("/w " .. targetName, "All")
        end
    end)
end

