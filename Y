local Tabs = {}
local tabOrder = 0
local function AddTab(name)
    tabOrder = tabOrder + 1
    local Page = Instance.new("Frame", Content) Page.Size, Page.BackgroundTransparency, Page.Visible = UDim2.new(1, 0, 1, 0), 1, false
    
    local Scroll = Instance.new("ScrollingFrame", Page) Scroll.Size, Scroll.BackgroundTransparency, Scroll.AutomaticCanvasSize, Scroll.ScrollBarThickness = UDim2.new(1, 0, 1, 0), 1, "Y", 3
    Scroll.ScrollBarImageColor3 = C_Periwinkle
    Instance.new("UIListLayout", Scroll).Padding = UDim.new(0, 5)
    
    local TabBtn = Instance.new("TextButton", SideScroll) 
    TabBtn.Size = UDim2.new(1, 0, 0, 30)
    TabBtn.Text = name
    TabBtn.LayoutOrder = tabOrder
    TabBtn.BackgroundColor3 = ThemeColors.Box
    TabBtn.TextColor3 = C_Periwinkle
    TabBtn.Font = Enum.Font.GothamBold
    TabBtn.TextSize = 13
    Corner(TabBtn, 5)

    local TabStroke = Instance.new("UIStroke", TabBtn)
    TabStroke.Color = Color3.fromRGB(35, 45, 65)
    TabStroke.Thickness = 1

    TabBtn.MouseButton1Click:Connect(function()
        for _, v in pairs(Tabs) do 
            v.Page.Visible = false
            v.Btn.BackgroundColor3 = ThemeColors.Box
            v.Btn.TextColor3 = C_Periwinkle
            v.Stroke.Color = Color3.fromRGB(35, 45, 65)
        end
        Page.Visible = true
        TabBtn.BackgroundColor3 = ThemeColors.Nav
        TabBtn.TextColor3 = C_LightCyan
        TabStroke.Color = C_BrightBlue
    end)
    Tabs[name] = {Page = Page, Scroll = Scroll, Btn = TabBtn, Stroke = TabStroke}
    return Scroll, Page
end

local function AddBtn(tab, text, func)
    local b = Instance.new("TextButton", tab) b.Size, b.Text, b.BackgroundColor3, b.TextColor3 = UDim2.new(1, -6, 0, 34), text, ThemeColors.Box, C_LightCyan Corner(b)
