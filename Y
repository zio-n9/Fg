end

local function AddToggle(tab, text, key, callback)
    local f = Instance.new("Frame", tab) f.Size, f.BackgroundColor3 = UDim2.new(1, -6, 0, 34), ThemeColors.Box Corner(f)
    local s = Instance.new("UIStroke", f) s.Color = Color3.fromRGB(35, 45, 65) s.Thickness = 1
