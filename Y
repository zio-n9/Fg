    local sw = Instance.new("TextButton", f) sw.Size, sw.Position, sw.Text, sw.BackgroundColor3 = UDim2.new(0, 34, 0, 20), UDim2.new(1, -40, 0.5, -10), "", cfg[key] and C_BrightBlue or Color3.fromRGB(35, 45, 65) Corner(sw, 10)
    sw.MouseButton1Click:Connect(function() 
        cfg[key] = not cfg[key] 
        sw.BackgroundColor3 = cfg[key] and C_BrightBlue or Color3.fromRGB(35, 45, 65) 
        if callback then callback(cfg[key]) end
    end)
end

